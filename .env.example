# Copy to .env and fill in. Everything except the keys has a sensible default.

# --- Claude (leave empty to run OFFLINE with procedural agents) ---
ANTHROPIC_API_KEY=
HIVE_OVERMIND_MODEL=claude-opus-5-5
HIVE_DRONE_MODEL=claude-opus-5-5        # claude-sonnet-5-5 or claude-haiku-5-5 make drones much cheaper
HIVE_OVERMIND_EFFORT=high                # low | medium | high | xhigh | max
HIVE_DRONE_EFFORT=medium
HIVE_LLM_BUDGET_USD=                     # empty = no limit; agents pause when the spend reaches it
HIVE_LLM_FALLBACKS=true                  # server-side refusal fallbacks (fallbacks="default")

# --- hive dynamics ---
HIVE_MAX_DRONES=4                        # living drones at once
HIVE_STRATEGIES_PER_ROUND=5              # strategies each drone designs per round
HIVE_DRONE_MAX_STRIKES=3                 # rounds without improvement before a drone is permanently deleted
HIVE_DRONE_COOLDOWN_SEC=20               # pause between a drone's rounds
HIVE_OVERMIND_INTERVAL_SEC=150           # Overmind decision cycle
HIVE_OVERMIND_PATIENCE=4                 # stagnant cycles before the Overmind is deleted and replaced
HIVE_WORKERS=                            # backtest processes (default: CPU cores - 1)
HIVE_GA_BATCH=48                         # strategies per evolver batch

# --- the challenge to beat: topstep_50k | topstep_100k | topstep_150k | apex_50k | apex_100k | tradeify_50k | ftmo_100k | custom
PROP_PRESET=topstep_50k
# PROP_PRESET=custom uses these:
# PROP_NAME=My firm 50K
# PROP_START_BALANCE=50000
# PROP_PROFIT_TARGET=3000
# PROP_MAX_LOSS=2000
# PROP_TRAILING=eod                      # static | eod | intraday
# PROP_TRAIL_LOCKS=true
# PROP_DAILY_LOSS=1000                   # 0 = none
# PROP_DLL_FAILS=false
# PROP_CONSISTENCY=0.5                   # 0 = none
# PROP_MIN_DAYS=2
# PROP_HORIZON_DAYS=30
# PROP_MAX_CONTRACTS=5
# PROP_FEE=49

# --- markets / data ---
INSTRUMENTS=MNQ,MES,MGC                  # also NQ, ES, GC, M2K, MYM, M6E
TIMEFRAMES=5,15
DATA_SOURCE=auto                         # auto (alpaca if keys set, else synthetic) | alpaca | yahoo | synthetic
HISTORY_DAYS=730
# INSTRUMENT_RATIOS=MNQ:41.2,MES:10.05,MGC:10.9   # futures price / ETF price, update if stale

# --- Alpaca (paper) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_DATA_FEED=sip                     # historical bars; falls back to iex on the free plan
ALPACA_LIVE_FEED=iex
PAPER_SIZE_SCALE=1.0                     # 0.1 trades a tenth of the size (challenge P&L is rescaled)

# --- server ---
HOST=127.0.0.1
PORT=8000
